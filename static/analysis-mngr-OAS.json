        "parameters": {
            "X-RqUID": {
                "example": "123e4567-e89b-12d3-a456-426614174000",
                "name": "X-RqUID",
                "description": "Identificador único de la petición, se recomienda usar un UUID v4",
                "schema": {
                    "maxLength": 50,
                    "pattern": "^[A-Za-z0-9-]+$",
                    "type": "string"
                },
                "in": "header",
                "required": true
            },
            "X-Type": {
                "example": "url",
                "name": "X-Type",
                "description": "Tipo de contenido del request, puede ser url o file",
                "schema": {
                    "enum": ["url", "file"],
                    "type": "string"
                },
                "in": "header",
                "required": true
            }
        },
        "examples": {},
