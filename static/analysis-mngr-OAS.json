                                "description": "Respuesta obtenida en caso de que alguno de los parámetros enviados no corresponda con los parámetros esperados",
                                "value": {
                                    "Status": {
                                        "ServerStatusCode": "400",
                                        "Severity": "Error",
                                        "StatusCode": 400,
                                        "StatusDesc": "Problems Status 400"
