    "components": {
        "schemas": {
            "MsgRsErrorDef": {
                "title": "Root Type for MsgRsErrorDef",
                "description": "Root Type for MsgRsErrorDef",
                "type": "object",
                "properties": {
                    "Status": {
                        "$ref": "#/components/schemas/Status"
                    },
                    "EndDt": {
                        "format": "date-time",
                        "description": "Fecha Error",
                        "maxLength": 20,
                        "minLength": 1,
                        "type": "string"
                    }
                },
                "additionalProperties": false
            },
            "Status": {
                "type": "object",
                "properties": {
                    "ServerStatusCode": {
                        "description": "Códigos de error string",
                        "maxLength": 10,
                        "minLength": 1,
                        "pattern": "^[a-zA-Z0-9]*$",
                        "type": "string"
                    },
                    "Severity": {
                        "description": "Severity Error",
                        "maxLength": 10,
                        "minLength": 1,
                        "pattern": "^[a-zA-Z0-9]*$",
                        "type": "string"
                    },
                    "StatusCode": {
                        "format": "int32",
                        "description": "Códigos de error numérico",
                        "maximum": 600,
                        "minimum": 0,
                        "type": "integer"
                    },
                    "StatusDesc": {
                        "description": "Descripción del error",
                        "maxLength": 200,
                        "minLength": 1,
                        "pattern": "^[a-zA-Z0-9]*$",
                        "type": "string"
                    }
                },
                "additionalProperties": false
            },
            "BodyAnalyze": {
                "title": "Root Type for BodyAuthentication",
                "description": "Informacion necesaria para la creacion de aliado",
                "type": "object",
                "required": ["requestUrl"],
                "properties": {
                    "requestUrl": {
                        "description": "URL del repositorio o archivo a analizar",
                        "maxLength": 2048,
                        "type": "string"
                    }
                },
                "additionalProperties": false
            },
            "BodyAttachments": {
                "title": "Root Type for BodyAttachments",
                "description": "Informacion necesaria para la creacion de aliado",
                "type": "object",
                "required": ["fileName", "fileType"],
                "properties": {
                    "fileName": {
                        "description": "Nombre del archivo a subir",
                        "maxLength": 100,
                        "type": "string"
                    },
                    "fileType": {
                        "description": "Tipo de archivo a subir",
                        "maxLength": 50,
                        "type": "string"
                    }
                },
                "additionalProperties": false
            }
        },
